# 复制为 .env 后按需填写（.env 已在 .gitignore 中，不会入库）
#
# 全部可留空：留空时爬虫直连出网，检索回落到零 key 的检索源。
# 留空不影响编译、单测与集成测试。

# ── 检索：博查（Bocha）Web Search ───────────────────────────────
# 国内直连、无需代理、无反爬，评测/演示首选检索源。
# 限速（Tier 0）：QPS=1 / QPM=30 / QPD=1000；检索器内置进程级节流器，
# 保证两次「发起」间隔 ≥ BOCHA_MIN_INTERVAL（流水线式，不阻塞响应）。
BOCHA_API_KEY=
# BOCHA_MIN_INTERVAL=1.05

# ── 抓取：出网代理（可选）─────────────────────────────────────
# 部分站点在特定网络下需要代理；留空 = 直连。
# 注意：本地代理常只监听 127.0.0.1，容器在自己的网络命名空间里够不着宿主机，
# 需让代理监听容器可达的地址（如宿主在容器网桥上的地址）。
DDG_PROXY=
HTTP_PROXY=
HTTPS_PROXY=
# NO_PROXY 必须包含 bochaai.com 与 gptr-searxng：前者否则检索会绕代理变慢，
# 后者否则 crawler 调同网络的 SearXNG 也会被拽去走代理（变慢或直接不通）。
NO_PROXY=localhost,127.0.0.1,.local,bochaai.com,gptr-crawler,gptr-postgres,gptr-minio,gptr-searxng

# ── 检索：自建 SearXNG（可选，零 key）─────────────────────────
# 前置：实例配置不入库，先复制模板再按需改（详见 BUILD.md 的「自建 SearXNG」一节）：
#     cp searxng/settings.yml.example searxng/settings.yml
# 用 docker compose 起的实例地址（同网络用服务名）；留空则环境默认值即此值。
# 用法：任务 config 的 retriever 填 searx（与 worker 启动参数 gptr.clients.search-chain
# 是两层不同的命名，后者只接受 duckduckgo/python）。
SEARX_URL=
# 引擎白名单：留空 = 用实例默认引擎集，但默认集**实测只有 `google cse` 一个引擎真的出结果**
# （`brave` 限流、`duckduckgo` 报 CAPTCHA），引擎冗余为零；显式点名后产出可翻倍。
# 下面这组是**某次实测可用**的示例值（中文查询 47 条/43 个域名 vs 默认集 20 条/1 个引擎）。
# ⚠️ 引擎可用性由**你的出口 IP**决定，换出口要重新实测；名字以实例 `/search?engines=` 接受的名字为准
# （`/config` 里的 `enabled: false` 不影响显式点名——实测点名后照样出结果）。
SEARX_ENGINES=google cse,yandex,quark,sogou,360search
# 实测：传 `zh-CN` 会让 `sogou` 也变成不可用、结果变少（39 vs 47），故默认留空。
SEARX_LANGUAGE=
